# Copy these lines into Streamlit Cloud: App -> Settings -> Secrets
# (or into .streamlit/secrets.toml for a local run; that file is git-ignored)
GROQ_API_KEY = "your-groq-api-key"
GROQ_MODEL = "openai/gpt-oss-20b"

# Google Sheets audit log (see google_apps_script.gs)
SHEETS_WEBHOOK_URL = "https://script.google.com/macros/s/.../exec"
SHEETS_TOKEN = "the same token as TOKEN in the Apps Script"
